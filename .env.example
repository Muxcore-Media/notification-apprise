# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=notification-apprise

# Module-specific settings
# NOTIFY_GRPC_ADDR=:9445
# APPRISE_URL=http://localhost:8000
# APPRISE_URLS=  (semicolon-separated Apprise notification URLs, e.g. slack://token_a/token_b/token_c)
# APPRISE_TOKEN= (optional API key if Apprise has tag-based access control)

# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=notification-apprise

# Data / auth
# MUXCORE_DATA=data
# NOTIFY_MODULE_TOKEN=
# MUXCORE_MODULE_TOKEN=

# Module-specific settings
# NOTIFY_GRPC_ADDR=127.0.0.1:9445
# APPRISE_URL=http://localhost:8000
# APPRISE_URLS=  (semicolon-separated Apprise notification URLs, e.g. slack://token_a/token_b/token_c)
# APPRISE_TOKEN= (optional Bearer token for Apprise API auth)
# DISCORD_WEBHOOK=
# SLACK_WEBHOOK=
# WEBHOOK_URL=

# MVP host (optional extra notification sink)
# MVP_ENABLE_NOTIFICATION_APPRISE=1

# Settings keys (admin-ui / mesh; persist to $MUXCORE_DATA/notification-apprise/settings.json):
# apprise_url, apprise_urls, apprise_token
# discord_webhook, slack_webhook, webhook_url
# notify_requested, notify_file_added, notify_import_failed, notify_download_failed
# notify_download_started, notify_download_completed, notify_download_dispatched
# notify_media_added, notify_media_removed
